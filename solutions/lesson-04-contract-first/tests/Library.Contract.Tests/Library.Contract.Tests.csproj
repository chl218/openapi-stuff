<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>   <!-- this is a test project, never published as a NuGet package -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />                  <!-- lets `dotnet test` run the tests -->
    <PackageReference Include="xunit" Version="2.*" />                                 <!-- the test framework -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />             <!-- connects xunit to dotnet test / IDEs -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />     <!-- WebApplicationFactory: runs the server in memory -->
    <!-- The server under test. -->
    <ProjectReference Include="../../src/Library.Server/Library.Server.csproj" />
  </ItemGroup>

  <!-- Same trick as the server: generated files are added by the target below. -->
  <ItemGroup>
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <!-- Regenerate the typed C# client from the contract before every compile. -->
  <Target Name="GenerateClient" BeforeTargets="CoreCompile">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
    <Exec Command="dotnet nswag run nswag.json" WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <ItemGroup>
      <Compile Include="Generated/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
