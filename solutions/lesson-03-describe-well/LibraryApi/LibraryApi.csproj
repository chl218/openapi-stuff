<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Writes the /// XML comments to a file. .NET 10 copies them into the OpenAPI document as descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Warning 1591 = "public member has no XML comment". Silenced so only the comments you wrote are used. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />      <!-- generates the document -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="*" />    <!-- the /swagger page -->
  </ItemGroup>

</Project>
